STORIX_AI_ENV=local
STORIX_AI_PIPELINE_VERSION=v0.0
# Spring 과 같은 값. 실제 값은 팀 내부 채널에서 공유
STORIX_AI_INTERNAL_TOKEN=
# Spring 내부 API 주소 (작품 enum 카탈로그 등). 실제 값은 팀 내부 채널에서 공유
STORIX_AI_SPRING_BASE_URL=
# BE 없이 띄울 때 카탈로그 파일. 쓰면 SPRING_BASE_URL 대신 이 파일을 읽는다
STORIX_AI_CATALOG_FILE=tests/fixtures/works_catalog.json
# 답변(Sonnet) 호출용. Anthropic SDK 가 이 이름을 그대로 읽는다. 실제 값은 팀 내부 채널에서 공유
ANTHROPIC_API_KEY=
